		"@kestrel/domain": "workspace:*",
		"@kestrel/publish": "workspace:*",
		"better-auth": "^1.7.14",
		"drizzle-orm": "^0.45.4",
		"fastify": "^5.12.7",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11"
	}
}
