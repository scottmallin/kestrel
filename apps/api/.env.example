PORT=3000
BASE_URL=http://localhost:3000
# Any long random string; signs session cookies.
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Leave unset to use PGlite in .data/ (no Postgres needed), or point at Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kestrel
# The editor's dev server, which talks to the API through its /api proxy.
TRUSTED_ORIGINS=http://localhost:5173
